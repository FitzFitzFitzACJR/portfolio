# Frontend environment variables (Vite).
# Copy to frontend/.env. Only VITE_-prefixed vars reach the browser, and they are
# baked in at BUILD time, so never put secrets here and redeploy after changing them.

# URL of the backend API (Render Web Service URL in production).
VITE_API_BASE_URL=http://localhost:5000

# Personal details (name, links, projects) live in src/content/profile.js, not here.

# Public URL of the deployed site (no trailing slash), e.g. https://arnold-cutad.onrender.com
# Enables the canonical URL, Open Graph/Twitter image and URL, and sitemap.xml.
VITE_SITE_URL=
