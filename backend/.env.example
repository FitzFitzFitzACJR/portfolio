# Backend environment variables.
# Copy this file to backend/.env and fill in real values.
# NEVER commit real values: backend/.env is gitignored, and on Render you set
# these in the service's Environment tab instead.

# --- Server -------------------------------------------------------------------
# Render sets PORT automatically; 5000 is the local default.
PORT=5000
# development | production
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (your deployed frontend).
# Example: https://your-frontend.onrender.com,https://www.your-domain.com
FRONTEND_URL=
# Number of reverse proxies in front of the app (for correct client IPs in rate limiting).
# Defaults to 1 in production (Render), 0 otherwise.
# TRUST_PROXY=1

# --- AI assistant (Claude) ---------------------------------------------------
# API key from https://console.anthropic.com (Settings > API Keys). Secret: never commit it.
# Tip: set a monthly spend limit in the Console as a second safety net.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# Optional. Defaults to claude-haiku-4-5 (fast and inexpensive).
# ANTHROPIC_MODEL=claude-haiku-4-5
# Optional. Max chat messages per UTC day across ALL visitors (protects your bill).
# Defaults to 300; 0 disables the cap.
# CHAT_DAILY_LIMIT=300

# --- GitHub -------------------------------------------------------------------
# The username and which repos to show/hide come from frontend/src/content/profile.js
# (exported by `npm run kb:export`). Optional token: raises GitHub's API limit from
# 60 to 5,000 requests/hour. A fine-grained token with no extra permissions is enough.
# GITHUB_TOKEN=
