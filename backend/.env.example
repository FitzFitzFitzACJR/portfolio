# Backend environment variables.
# Copy this file to backend/.env and fill in real values.
# NEVER commit real values: backend/.env is gitignored, and on Render you set
# these in the service's Environment tab instead.

# --- Server -------------------------------------------------------------------
# Render sets PORT automatically; 5000 is the local default.
PORT=5000
# development | production
NODE_ENV=development
# Comma-separated list of origins allowed to call this API (your deployed frontend).
# Example: https://your-frontend.onrender.com,https://www.your-domain.com
FRONTEND_URL=
# Number of reverse proxies in front of the app (for correct client IPs in rate limiting).
# Defaults to 1 in production (Render), 0 otherwise.
# TRUST_PROXY=1

# --- Flowise chatbot ----------------------------------------------------------
# Option A (recommended): the full prediction endpoint for your chatflow.
# In Flowise, open the chatflow and click the "</>" (API Endpoint) button to copy it.
# It must contain /api/v1/prediction/, NOT just the site root.
FLOWISE_API_URL=https://cloud.flowiseai.com/api/v1/prediction/<your-chatflow-id>

# Option B: leave FLOWISE_API_URL empty and set these two instead.
# FLOWISE_BASE_URL=https://cloud.flowiseai.com
# FLOWISE_CHATFLOW_ID=<your-chatflow-id>

# API key from Flowise > API Keys. Only needed if the chatflow requires one.
FLOWISE_API_KEY=<your-flowise-api-key>

# --- GitHub -------------------------------------------------------------------
GITHUB_PROFILE_URL=https://github.com/FitzFitzFitz69
